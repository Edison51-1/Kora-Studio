{
  "name": "kora-studio",
  "version": "0.2.0",
  "description": "KORA Studio - éditeur vidéo, image et audio",
  "author": "Jonard",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --publish never" },
  "dependencies": { "ffmpeg-static": "^5.2.0", "ffprobe-static": "^3.1.0" },
  "devDependencies": { "electron": "^33.2.0", "electron-builder": "^25.1.8" },
  "build": {
    "appId": "com.kora.studio",
    "productName": "KORA Studio",
    "icon": "build/icon.png",
    "asarUnpack": ["node_modules/ffmpeg-static/**", "node_modules/ffprobe-static/**"],
    "files": ["main.js", "preload.js", "export.js", "renderer/**", "build/icon.png", "package.json"],
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage", "category": "AudioVideo" }
  }
}
