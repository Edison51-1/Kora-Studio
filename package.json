{
  "name": "kora-studio",
  "version": "0.5.0",
  "description": "KORA Studio - éditeur vidéo, image et audio",
  "author": {
    "name": "Jonard",
    "email": "jonard@users.noreply.github.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/export.test.js",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.kora.studio",
    "productName": "KORA Studio",
    "icon": "build/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "export.js",
      "runner.js",
      "shared.js",
      "asr.js",
      "asr-worker.js",
      "renderer/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "Jonard <jonard@users.noreply.github.com>"
    },
    "asar": false
  },
  "homepage": "https://github.com/Edison51-1/Kora-Studio"
}